{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/examples",
  "description": "Example games made with NanoForge",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.ts",
    "fix": "node scripts/check.ts --fix",
    "format": "prettier --write .",
    "lint": "prettier --check . && node scripts/check.ts",
    "test": "node --test scripts/check.test.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=26"
  },
  "private": true
}
