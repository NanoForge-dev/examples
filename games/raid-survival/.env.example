# Copy to .env. nf start gives NANOFORGE_CLIENT_X to the client and NANOFORGE_SERVER_X to the
# server, as X. Everything the client gets reaches the browser.
NANOFORGE_CLIENT_SERVER_ADDRESS=127.0.0.1
NANOFORGE_CLIENT_SERVER_TCP_PORT=4945
NANOFORGE_CLIENT_SERVER_UDP_PORT=4944

NANOFORGE_SERVER_LISTENING_TCP_PORT=4945
NANOFORGE_SERVER_LISTENING_UDP_PORT=4944
